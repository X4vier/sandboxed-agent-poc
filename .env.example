# Optional dev convenience: seed an Anthropic API key so you don't have to type
# it in the app on each launch. If unset, the app prompts for the key at startup
# and holds it in memory only (never written to disk). Packaged builds ignore
# this and always prompt.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the model (defaults to claude-sonnet-5).
AGENT_MODEL=claude-sonnet-5

# Optional: reasoning/effort level — low | medium | high | xhigh | max (default medium).
AGENT_EFFORT=low

# Optional: the model's context window in tokens (default 200000). Each agent
# compacts its own history before this fills, rather than the run being aborted
# on a token count. Raise it when running with a larger-context beta.
AGENT_CONTEXT_WINDOW=200000

# Optional: fraction of the context window at which an agent compacts (default 0.8).
AGENT_COMPACT_THRESHOLD=0.8
