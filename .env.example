# Optional dev convenience: seed an Anthropic API key so you don't have to type
# it in the app on each launch. If unset, the app prompts for the key at startup
# and holds it in memory only (never written to disk). Packaged builds ignore
# this and always prompt.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the model (defaults to claude-sonnet-5).
AGENT_MODEL=claude-sonnet-5

# Optional: reasoning/effort level — low | medium | high | xhigh | max (default medium).
AGENT_EFFORT=low

# Optional: cumulative token budget ceiling for a single run (default 500000).
AGENT_TOKEN_BUDGET=500000
