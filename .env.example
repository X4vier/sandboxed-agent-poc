# Required: your Anthropic API key for the PoC.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the model (defaults to claude-sonnet-5).
AGENT_MODEL=claude-sonnet-5

# Optional: reasoning/effort level — low | medium | high | xhigh | max (default medium).
AGENT_EFFORT=low

# Optional: cumulative token budget ceiling for a single run (default 500000).
AGENT_TOKEN_BUDGET=500000
